<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NexusUI Layout & Menus</title>
  <style>
    body { font-family: sans-serif; margin: 0; }
    header, footer { padding: 1rem; background: #1e1b4b; color: #fff; }
    nav ul, aside ul { list-style: none; padding: 0; margin: 0; }
    nav ul { display: flex; gap: 1rem; }
    nav a, aside a { color: inherit; text-decoration: none; }
    main { display: flex; gap: 1.5rem; padding: 1.5rem; }
    aside { width: 180px; }
    section { flex: 1; }
  </style>
</head>
<body>
  <header>
    <h2>NexusUI</h2>
    <nav aria-label="Main Menu">
      <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#inbox">Inbox</a></li>
        <li><a href="#settings">Settings</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <aside aria-label="Side Menu">
      <ul>
        <li><a href="#overview">Overview</a></li>
        <li><a href="#messages">Messages</a></li>
      </ul>
    </aside>
    <section id="home">
      <h1>Welcome Back, User</h1>
      <p>Your workspace is synced.</p>
    </section>
  </main>

  <footer>
    <p>&copy; 2026 NexusUI App</p>
  </footer>
</body>
</html>
